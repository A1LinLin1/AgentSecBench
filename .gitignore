# Publication repository policy: ignore the research workspace by default.
# Only the explicitly unignored code, tests, documentation, and CI files below
# may be staged. This prevents corpus snapshots, annotations, credentials, and
# local execution outputs from being added by an accidental `git add .`.
/*
!/.gitignore
!/README.md
!/CONTRIBUTING.md
!/SECURITY.md
!/CHANGELOG.md
!/LICENSE
!/NOTICE
!/pyproject.toml
!/agentsecbench.example.toml
!/agentsecbench-suppressions.example.toml
!/action.yml
!/.github/
!/.github/**

# Installable engineering package. Research scripts remain available as
# compatibility entry points while stable APIs move under src/agentsecbench.
!/src/
!/src/**
/src/**/__pycache__/
/src/*.egg-info/
/build/
/dist/
/agentsecbench-results/

# Method implementation and deterministic test fixtures.
!/scripts/
!/scripts/**
/scripts/**/__pycache__/
*.py[cod]
!/tests/
!/tests/**
/tests/**/__pycache__/

# Small, hand-authored benchmark and baseline definitions only.
!/baselines/
!/baselines/**
/baselines/results/
/baselines/codeql/heldout/
/baselines/semgrep/heldout/
!/benchmarks/
/benchmarks/*
!/benchmarks/security_adg_micro/
!/benchmarks/security_adg_micro/**

# Method configurations and standalone visualization templates.
!/experiments/
!/experiments/**

# Public, method-level documentation only. Disclosure, reproduction records,
# and unpublished result summaries remain local until explicitly released.
!/docs/
/docs/*
!/docs/SECURITY_ADG_PIPELINE.md
!/docs/PAPER_EXECUTION_PLAN.md
!/docs/MUTATION_V4_PROTOCOL.md
!/docs/PROJECT_REVIEW_20260903.md
!/docs/GOLD_SET_DEFINITION.md
!/docs/BASELINE_MATCHING_POLICY.md
!/docs/PRODUCT_ROADMAP.md
!/docs/OUTPUT_SCHEMA_COMPATIBILITY.md
!/docs/USER_GUIDE.md
!/docs/FRAMEWORK_COVERAGE.md
!/docs/assets/
!/docs/assets/**
!/docs/HELD_OUT_ANNOTATION_OPERATIONS.md
!/docs/MODEL_ASSISTED_REPRODUCIBLE_GOLD_PROTOCOL.md
!/docs/REPRODUCTION_GROUND_TRUTH_PROTOCOL.md
!/docs/PAPER_GROUND_TRUTH_CONSTRUCTION_SECTION.md
!/docs/PAPER_RQ_EXPERIMENT_MAPPING.md
!/docs/METHOD_SECTION_DRAFT.md
!/docs/PAPER_CLOSING_MASTER_DOCUMENT.md

# UI/framework source and annotation protocols; never participant, model, or
# task records.
!/annotations/
/annotations/*
!/annotations/annotation_guide.md
!/annotations/annotation_guide_v2.md
!/annotations/recall_inventory/
/annotations/recall_inventory/*
!/annotations/recall_inventory/HELD_OUT_ANNOTATION_GUIDE.md
!/annotations/heldout_annotation_ui/
!/annotations/heldout_annotation_ui/**
!/annotations/heldout_model_panel/
/annotations/heldout_model_panel/*
!/annotations/heldout_model_panel/system_prompt.md
!/annotations/heldout_model_panel/user_prompt_template.md
!/annotations/heldout_model_panel/output_schema.json
!/annotations/human_annotation_ui/
!/annotations/human_annotation_ui/**
!/annotations/model_audit_ui/
!/annotations/model_audit_ui/**
!/annotations/case_review_ui/
!/annotations/case_review_ui/**
!/annotations/model_annotation/
/annotations/model_annotation/*
!/annotations/model_annotation/*.md
!/annotations/model_annotation/output_schema.json

# Keep only toolchain metadata, never downloaded executables or bundles.
!/tools/
/tools/*
!/tools/toolchain_manifest.json
!/tools/cloudflared/
/tools/cloudflared/README.md

# Local/private material (listed explicitly for readability and defense in
# depth; these are already covered by the default-deny rule above).
/.secrets/
/.venv/
/.runtime/
/dataset/
/metadata/
/analysis/
/graphs/
/artifacts/
/benchmarks/derived/
/annotations/annotator/
/annotations/model_audit/reviewers/
/annotations/model_annotation/inputs/
/annotations/model_annotation/runs/
/tools/_downloads/
/tools/codeql-*/
/tools/cloudflared/cloudflared.exe
