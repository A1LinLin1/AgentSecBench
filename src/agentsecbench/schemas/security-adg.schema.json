{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://agentsecbench.dev/schemas/1.0/security-adg.schema.json",
  "title": "AgentSecBench candidate-centered Security-ADG",
  "type": "object",
  "required": ["schema_version", "generator", "graph_id", "candidate_id", "provenance", "nodes", "edges", "analysis", "views", "claim_boundary"],
  "properties": {
    "schema_version": {"const": "1.0"},
    "generator": {"type": "string", "minLength": 1},
    "graph_id": {"type": "string", "pattern": "^SADG-"},
    "candidate_id": {"type": "string", "pattern": "^ASB-"},
    "provenance": {
      "type": "object",
      "required": ["scan_root", "file", "line_start", "line_end", "finding_fingerprint", "evidence_hash_verified", "label_inputs_used", "source_execution_used"],
      "properties": {
        "scan_root": {"type": "string"}, "file": {"type": "string", "minLength": 1},
        "line_start": {"type": "integer", "minimum": 1}, "line_end": {"type": "integer", "minimum": 1},
        "finding_fingerprint": {"type": "string", "pattern": "^ASBFP-[0-9A-F]{24}$"},
        "evidence_hash_verified": {"type": "boolean"}, "label_inputs_used": {"type": "boolean"},
        "source_execution_used": {"type": "boolean"}
      },
      "additionalProperties": false
    },
    "nodes": {"type": "array", "minItems": 4, "items": {"type": "object", "required": ["id", "type"]}},
    "edges": {"type": "array", "items": {"type": "object", "required": ["from", "to", "type"]}},
    "analysis": {"type": "object", "required": ["engine", "dependency_paths", "framework_evidence", "interprocedural", "limitations"]},
    "views": {"type": "object", "required": ["sink_only", "plain_adg", "security_adg"]},
    "claim_boundary": {"type": "string", "minLength": 1}
  },
  "additionalProperties": false
}
